rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para la colección principal de novedades limpias 2026
    match /novedades_tesalia_2026/{incidentId} {
      allow read, write: if true;
    }

    // Reglas para novedades vinculadas específicamente a cada cuenta de Google
    match /users/{userId}/incidents/{incidentId} {
      allow read, write: if true;
    }

    // Repositorio documental Drive (Carpetas)
    match /folders/{folderId} {
      allow read, write: if true;
    }

    // Repositorio documental Drive (Documentos)
    match /documents/{documentId} {
      allow read, write: if true;
    }

    // Colección de sincronización de estado del sistema
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}
